# local: 내 PC 전용. 공개 배포 시 production과 HTTPS·키 설정 필수.
APP_ENV=local
PUBLIC_BASE_URL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
DATA_DIR=data

# Instagram Login용 App ID/Secret.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v25.0

# PUBLIC_BASE_URL + /auth/instagram/callback 과 정확히 일치해야 합니다.
INSTAGRAM_REDIRECT_URI=

# 실제 호출은 별도로 켭니다. 키·단가·예산 설정 전에는 비활성 상태를 유지합니다.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# 이 앱의 누적 지출 한도.
OPENAI_BUDGET_USD=0

# 캐시 쓰기 등 적용될 수 있는 입력 단가를 모두 포함하는 보수적 상한 단가.
OPENAI_INPUT_CEILING_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0

# 별도 이미지 모델. 1024x1024 고정이며 high/medium/low만 지원
OPENAI_IMAGE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low

# 앱의 사전 예약액이며 API의 청구 상한 보장이 아닙니다. 실측 후 설정
IMAGE_CALL_RESERVE_USD=0
IMAGE_TEXT_INPUT_USD_PER_MILLION=0
IMAGE_INPUT_USD_PER_MILLION=0
IMAGE_OUTPUT_USD_PER_MILLION=0

# 최초 생성 1회+추가 1회, 무료 5건*2회인 프로토타입 초기 가정입니다.
IMAGE_ATTEMPTS_PER_POST=2
IMAGE_CALLS_PER_ACCOUNT=10

# 최적값이 아닌 초기 운영 가정.
OPENAI_MAX_OUTPUT_TOKENS=2048
AI_ATTEMPTS_PER_POST=3
AI_CALLS_PER_ACCOUNT=20
HISTORY_PAGE_SIZE=20
COMPARISON_HOURS=24
COMPARISON_TOLERANCE_HOURS=2
