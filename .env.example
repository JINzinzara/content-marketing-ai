# local: 내 PC 전용. 공개 배포 시 production과 HTTPS·키 설정 필수.
APP_ENV=local
PUBLIC_BASE_URL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
DATA_DIR=data

# Instagram Login용 App ID/Secret. Facebook App ID와 혼동하지 마세요.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v25.0

# PUBLIC_BASE_URL + /auth/instagram/callback 과 정확히 일치해야 합니다.
INSTAGRAM_REDIRECT_URI=

# 실제 OpenAI 호출은 명시적으로 켭니다. 모델·단가·예산 확인 전에는 비워두세요.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# 이 앱의 누적 지출 한도. 잔액 7.97달러를 자동으로 예산으로 쓰지 않습니다.
OPENAI_BUDGET_USD=0

# 캐시 쓰기 등 적용될 수 있는 입력 단가를 모두 포함하는 보수적 상한 단가.
OPENAI_INPUT_CEILING_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0

# 최적값이 아닌 초기 운영 가정. README에서 의미와 한계를 확인하세요.
OPENAI_MAX_OUTPUT_TOKENS=2048
AI_ATTEMPTS_PER_POST=3
AI_CALLS_PER_ACCOUNT=20
HISTORY_PAGE_SIZE=20
COMPARISON_HOURS=24
COMPARISON_TOLERANCE_HOURS=2
